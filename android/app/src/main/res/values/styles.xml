<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Not DayNight: the app UI is always dark (see
         capacitor.config.ts), so the native window/status-bar background must
         stay dark regardless of the device's own system theme setting -
         DayNight would otherwise paint this white on a light-mode device,
         which is exactly the sliver that showed behind the status bar. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- The running theme. Capacitor's BridgeActivity switches to it with
         setTheme() after the activity has already started on the launch theme
         below, and a late setTheme() layers this style over the launch one
         instead of replacing it: anything not set here is kept. The launch
         theme's android:background (the splash image) was kept that way, and a
         background set on a theme is the default background of every view the
         activity inflates - including the native dialog Android shows for an
         HTML <select>. Every dropdown opened as a box with the Zollify logo in
         each row, rows blown up to the image's size and the options hidden.
         Clearing it here puts the views back to their own backgrounds. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>