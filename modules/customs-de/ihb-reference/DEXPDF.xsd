<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="3.0.15.1" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:aie="urn:publicid:IDN+zoll.de:AIE">
	<xs:simpleType name="alpha">
		<xs:restriction base="xs:string">
			<xs:pattern value="[^\p{Cc}\p{Z}]([^\p{Cc}]*[^\p{Cc}\p{Z}])?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="DEXPDF" id="MES">
		<xs:annotation>
			<xs:documentation>
				<aie:name xml:lang="en" value="MESSAGE"/>
				<aie:name xml:lang="de" value="NACHRICHT"/>
				<aie:description value="Technischer Kopf"/>
				<aie:status value="R"/>
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="preparationDateAndTime" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Preparation date and time"/>
							<aie:name xml:lang="de" value="Zeitpunkt der Erstellung"/>
							<aie:description value="Datum und Zeit der Erstellung der Übertragungsdatei"/>
							<aie:status value="R"/>
							<aie:format value="DateTime (n14)"/>
							<aie:pcre value="\A(?!....-(?:02|04|06|09|11)-31|....-02-30|..(?:.[13579]|[02468][26]|[13579][048])-02-29)^(?:20[0-9][0-9])-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):(?:[0-5][0-9]):(?:[0-5][0-9])\Z"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:dateTime">
							<xs:minInclusive value="2000-01-01T00:00:00"/>
							<xs:maxInclusive value="2099-12-31T23:59:59"/>
							<xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="testIndicator" minOccurs="0" maxOccurs="0">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Test indicator"/>
							<aie:name xml:lang="de" value="Test-Indikator"/>
							<aie:status value="N"/>
							<aie:format value="n1"/>
							<aie:pcre value="\A1\Z"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="1"/>
							<xs:enumeration value="1"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="messageIdentification" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Message identification"/>
							<aie:name xml:lang="de" value="Nachrichtenkennung"/>
							<aie:description value="Eindeutige Nachrichtenreferenz"/>
							<aie:status value="R"/>
							<aie:format value="an..35"/>
							<aie:pcre value="\A.{1,35}\Z"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="alpha">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="messageGroup" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Message group"/>
							<aie:name xml:lang="de" value="Nachrichtengruppe"/>
							<aie:description value="Zuordnung der Nachricht zu einer Gruppe gemäß der &#x201E;Versionsübersicht&#x201C; im übergreifenden Teil des IHBs"/>
							<aie:status value="R"/>
							<aie:format value="a3"/>
							<aie:pcre value="\AEXP\Z"/>
							<aie:list value="A0110"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="3"/>
							<xs:enumeration value="EXP"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="messageType" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Message type"/>
							<aie:name xml:lang="de" value="Nachrichtentyp"/>
							<aie:description value="Technischer Nachrichtentyp"/>
							<aie:status value="R"/>
							<aie:format value="a6"/>
							<aie:pcre value="\ADEXPDF\Z"/>
							<aie:list value="A0057"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="6"/>
							<xs:enumeration value="DEXPDF"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="messageVersion" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Message version"/>
							<aie:name xml:lang="de" value="Nachrichtenversion"/>
							<aie:description value="Zuordnung des fachlichen Nachrichtentyps anhand der Versionsnummer"/>
							<aie:status value="R"/>
							<aie:format value="an..7"/>
							<aie:pcre value="\AF\.[1-9][0-9]?\.[1-9]?[0-9]\Z"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="alpha">
							<xs:minLength value="1"/>
							<xs:maxLength value="7"/>
							<xs:pattern value="F\.[1-9][0-9]?\.[1-9]?[0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="correlationIdentifier" minOccurs="0" maxOccurs="0">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="Correlation identifier"/>
							<aie:name xml:lang="de" value="Zuordnungskennung"/>
							<aie:description value="Kennung der referenzierten Bezugsnachricht"/>
							<aie:status value="N"/>
							<aie:format value="an..35"/>
							<aie:pcre value="\A.{1,35}\Z"/>
						</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="alpha">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MessageSender" minOccurs="1" maxOccurs="1" id="MET">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="MESSAGE SENDER"/>
							<aie:name xml:lang="de" value="NACHRICHTENSENDER"/>
							<aie:description value="Technischer Übermittler der Nachricht"/>
							<aie:status value="R"/>
						</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="identificationNumber" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Identification number"/>
										<aie:name xml:lang="de" value="Identifikationsnummer"/>
										<aie:description value="Identifikationsnummer des Nachrichtenübermittlers, unter der (ggf. in Verbindung mit einer angegebenen Niederlassungsnummer) Name und Anschrift gespeichert sind"/>
										<aie:status value="R"/>
										<aie:format value="an..17"/>
										<aie:pcre value="\A[A-Z]{2}[\x21-\x7E]{1,15}\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:minLength value="1"/>
										<xs:maxLength value="17"/>
										<xs:pattern value="[A-Z]{2}[&#x21;-&#x7E;]{1,15}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="subsidiaryNumber" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Subsidiary number"/>
										<aie:name xml:lang="de" value="Niederlassungsnummer"/>
										<aie:description value="Nummer der Niederlassung des Nachrichtenübermittlers, vergeben von der deutschen Zollbehörde"/>
										<aie:status value="R"/>
										<aie:format value="n4"/>
										<aie:pcre value="\A[0-9]{4}\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:length value="4"/>
										<xs:pattern value="[0-9]{4}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="authenticationNumber" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Authentication number"/>
										<aie:name xml:lang="de" value="BIN"/>
										<aie:description value="Beteiligten-Identifikations-Nummer"/>
										<aie:status value="R"/>
										<aie:format value="n25"/>
										<aie:pcre value="\A[0-9]{25}\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:length value="25"/>
										<xs:pattern value="[0-9]{25}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="MessageRecipient" minOccurs="1" maxOccurs="1" id="MER">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="MESSAGE RECIPIENT"/>
							<aie:name xml:lang="de" value="NACHRICHTENEMPFÄNGER"/>
							<aie:description value="Technischer Empfänger der Nachricht"/>
							<aie:status value="R"/>
						</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="referenceNumber" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Reference number"/>
										<aie:name xml:lang="de" value="Referenznummer"/>
										<aie:description value="Dienststellennummer der empfangenden Zollstelle"/>
										<aie:status value="R"/>
										<aie:format value="an8"/>
										<aie:pcre value="\ADE0[01][0-9]{4}\Z"/>
										<aie:list value="D0293"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:length value="8"/>
										<xs:pattern value="DE0[01][0-9]{4}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Scenario" minOccurs="0" maxOccurs="0" id="MEQ">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="SCENARIO"/>
							<aie:name xml:lang="de" value="SZENARIO"/>
							<aie:status value="N"/>
						</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="identificationNumber" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Identification number"/>
										<aie:name xml:lang="de" value="Identifikationsnummer"/>
										<aie:description value="Identifizierung eines technischen Testszenarios"/>
										<aie:status value="R"/>
										<aie:format value="n5"/>
										<aie:pcre value="\A[1-9][0-9]{4}\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:length value="5"/>
										<xs:pattern value="[1-9][0-9]{4}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="note" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Note"/>
										<aie:name xml:lang="de" value="Hinweis"/>
										<aie:description value="Hinweis zur Bearbeitung des technischen Testszenarios (Neubeginn oder Fortführung)"/>
										<aie:status value="R"/>
										<aie:format value="a2"/>
										<aie:pcre value="\A[A-Z]{2}\Z"/>
										<aie:list value="A0112"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="2"/>
										<xs:enumeration value="TB"/>
										<xs:enumeration value="TF"/>
										<xs:enumeration value="TS"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ExportOperation" minOccurs="1" maxOccurs="1" id="HEA">
					<xs:annotation>
						<xs:documentation>
							<aie:name xml:lang="en" value="EXPORT OPERATION"/>
							<aie:name xml:lang="de" value="KOPF"/>
							<aie:status value="R"/>
						</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="LRN" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="LRN"/>
										<aie:name xml:lang="de" value="LRN"/>
										<aie:description value="Innerbetrieblich als Bezugsnummer vom fachlichen Ersteller der Nachricht &#x201E;Anmeldung zur Ausfuhr&#x201C; (E_EXP_DAT) vergebenes Ordnungskriterium"/>
										<aie:status value="R"/>
										<aie:format value="an..22"/>
										<aie:pcre value="\A.{1,22}\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:minLength value="1"/>
										<xs:maxLength value="22"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="declarationType" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Declaration type"/>
										<aie:name xml:lang="de" value="Art der Anmeldung"/>
										<aie:status value="R"/>
										<aie:format value="an..5"/>
										<aie:pcre value="\A[A-Z]{2}\Z"/>
										<aie:list value="C0231"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:length value="2"/>
										<xs:pattern value="[A-Z]{2}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="additionalDeclarationType" minOccurs="0" maxOccurs="0">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Additional declaration type"/>
										<aie:name xml:lang="de" value="Zusätzliche Art der Anmeldung"/>
										<aie:status value="N"/>
										<aie:format value="a1"/>
										<aie:pcre value="\A[A-Z]\Z"/>
										<aie:list value="C0042"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="alpha">
										<xs:length value="1"/>
										<xs:pattern value="[A-Z]"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="exportDeclarationType" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Export declaration type"/>
										<aie:name xml:lang="de" value="Art der Ausfuhranmeldung"/>
										<aie:description value="Art der Anmeldung zum Ausfuhrverfahren mit Präzisierungen und ggf. Inanspruchnahme von Vereinfachungen"/>
										<aie:status value="R"/>
										<aie:format value="n8"/>
										<aie:pcre value="\A[0-9]{8}\Z"/>
										<aie:list value="A0121"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="8"/>
										<xs:enumeration value="00000100"/>
										<xs:enumeration value="00000110"/>
										<xs:enumeration value="00000200"/>
										<xs:enumeration value="00000210"/>
										<xs:enumeration value="00000400"/>
										<xs:enumeration value="00000901"/>
										<xs:enumeration value="00000902"/>
										<xs:enumeration value="00001300"/>
										<xs:enumeration value="00001310"/>
										<xs:enumeration value="00001410"/>
										<xs:enumeration value="00110100"/>
										<xs:enumeration value="00110110"/>
										<xs:enumeration value="00110200"/>
										<xs:enumeration value="00110210"/>
										<xs:enumeration value="00110400"/>
										<xs:enumeration value="00111300"/>
										<xs:enumeration value="00111310"/>
										<xs:enumeration value="00111410"/>
										<xs:enumeration value="00120100"/>
										<xs:enumeration value="00120110"/>
										<xs:enumeration value="00120200"/>
										<xs:enumeration value="00120210"/>
										<xs:enumeration value="00200100"/>
										<xs:enumeration value="00200110"/>
										<xs:enumeration value="00200200"/>
										<xs:enumeration value="00200210"/>
										<xs:enumeration value="00200400"/>
										<xs:enumeration value="00201300"/>
										<xs:enumeration value="00201310"/>
										<xs:enumeration value="00201410"/>
										<xs:enumeration value="10000000"/>
										<xs:enumeration value="10000400"/>
										<xs:enumeration value="10110000"/>
										<xs:enumeration value="10110400"/>
										<xs:enumeration value="10200000"/>
										<xs:enumeration value="10200400"/>
										<xs:enumeration value="11000000"/>
										<xs:enumeration value="11110000"/>
										<xs:enumeration value="11120000"/>
										<xs:enumeration value="11200000"/>
										<xs:enumeration value="12000000"/>
										<xs:enumeration value="12000400"/>
										<xs:enumeration value="12110000"/>
										<xs:enumeration value="12110400"/>
										<xs:enumeration value="12120000"/>
										<xs:enumeration value="12200000"/>
										<xs:enumeration value="12200400"/>
										<xs:enumeration value="13000000"/>
										<xs:enumeration value="20000000"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="partyConstellation" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Party constellation"/>
										<aie:name xml:lang="de" value="Beteiligten-Konstellation"/>
										<aie:description value="Die Beteiligten-Konstellation stellt die Beziehungen zwischen Ausführer(n), Anmelder und Nachrichtenersteller in den verschiedenen Möglichkeiten von Vertretungs- und Subunternehmer-Verhältnissen dar."/>
										<aie:status value="R"/>
										<aie:format value="n4"/>
										<aie:pcre value="\A[0-9]{4}\Z"/>
										<aie:list value="A0127"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="4"/>
										<xs:enumeration value="0000"/>
										<xs:enumeration value="0001"/>
										<xs:enumeration value="0010"/>
										<xs:enumeration value="0011"/>
										<xs:enumeration value="0100"/>
										<xs:enumeration value="0101"/>
										<xs:enumeration value="0110"/>
										<xs:enumeration value="0111"/>
										<xs:enumeration value="1000"/>
										<xs:enumeration value="1010"/>
										<xs:enumeration value="1100"/>
										<xs:enumeration value="1110"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="declarationSubmissionDateAndTime" minOccurs="1" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Declaration submission date and time"/>
										<aie:name xml:lang="de" value="Zeitpunkt der Anmeldung"/>
										<aie:description value="Datum und Zeit der Anmeldung"/>
										<aie:status value="R"/>
										<aie:format value="DateTime (n14)"/>
										<aie:pcre value="\A(?!....-(?:02|04|06|09|11)-31|....-02-30|..(?:.[13579]|[02468][26]|[13579][048])-02-29)^(?:20[0-9][0-9])-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):(?:[0-5][0-9]):(?:[0-5][0-9])\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:dateTime">
										<xs:minInclusive value="2000-01-01T00:00:00"/>
										<xs:maxInclusive value="2099-12-31T23:59:59"/>
										<xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="decisiveDate" minOccurs="0" maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										<aie:name xml:lang="en" value="Decisive Date"/>
										<aie:name xml:lang="de" value="Maßgebliches Datum"/>
										<aie:description value="Für die rückwirkende/nachträgliche Ausfuhranmeldung maßgebliches Datum"/>
										<aie:status value="D"/>
										<aie:format value="Date (n8)"/>
										<aie:pcre value="\A(?!....-(?:02|04|06|09|11)-31|....-02-30|..(?:.[13579]|[02468][26]|[13579][048])-02-29)^(?:20[0-9][0-9])-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])\Z"/>
									</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:date">
										<xs:minInclusive value="2000-01-01"/>
										<xs:maxInclusive value="2099-12-31"/>
