# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# Every setting the server reads is listed here. Those under "Can also be set in
# Server admin" may instead be set by the server owner in the app (Settings ->
# Server admin -> Server settings): saved there they apply at once and survive
# restarts, stored encrypted. A value set in this file always wins over the
# panel, and the panel shows it as locked.
#
# The full list, with what each one does, is in
# packages/server-core/src/server-settings.ts.

# ═══ Deployment - environment only ════════════════════════════════════════════

# Optional. Left empty, the server mints one on first start and keeps it in
# ZOLLIFY_DATA_DIR/jwt-secret (so it survives restarts and travels with backups).
# Changing it signs everyone out and makes stored keys unreadable.
ZOLLIFY_JWT_SECRET=

# Where SQLite and uploaded data live.
ZOLLIFY_DATA_DIR=./data

# Where published client module bundles are read from.
ZOLLIFY_MODULE_STORE=./modules-store

# Built web app to serve. Leave unset in development - Vite serves it instead.
ZOLLIFY_WEB_DIST=

# Android APKs the app updates itself from (npm run android:pack writes them).
# ZOLLIFY_APK_DIR=./apk
# Content-only shell updates (npm run publish:shell writes them).
# ZOLLIFY_SHELL_STORE=./shell-store
# Folder the host watches for Server admin -> Update server. Unset: no updates from the app.
# ZOLLIFY_DEPLOY_DIR=

PORT=8787
HOST=0.0.0.0
# LOG_LEVEL=info

# Set to 0 only for local HTTP development. Never in a deployment.
ZOLLIFY_REQUIRE_HTTPS=1

# 1 when running behind a reverse proxy that sets x-forwarded-* (or the number of hops).
ZOLLIFY_TRUST_PROXY=1

# Comma-separated exact origins. Leave empty for same-origin only.
ZOLLIFY_ALLOWED_ORIGINS=

# Caddy running in Docker on this host? Name its network (docker network ls)
# and the Caddyfile can use `reverse_proxy zollify:8787`. Used by docker compose.
CADDY_NETWORK=

# Creates the server owner on first start, once. Remove them afterwards.
# OWNER_EMAIL=
# OWNER_PASSWORD=

# ═══ Security tuning - read once at start-up, environment only ════════════════

# REQUIRE_CAPTCHA=1              # 0 only in tests
# CAPTCHA_BITS=18                # sign-in and sign-up proof-of-work strength
# SIGNUP_CAPTCHA_BITS=15         # public workshop sign-up
# RECEIPT_CAPTCHA_BITS=15        # online receipt lookup
# RECEIPT_LOOKUPS_PER_MIN=20
# RECEIPT_TTL_DAYS=400           # how long online receipts stay reachable
# AUTH_RATE_LIMIT_MAX=20         # sign-in attempts per minute per address
# REFRESH_RATE_LIMIT_MAX=60      # session renewals per minute per address
# PIN_RATE_LIMIT_MAX=30          # till PIN attempts per minute per address
# REFRESH_TTL_DAYS=30            # how long a sign-in lasts
# REFRESH_TTL_DAYS_CARBON=90     # on a myPOS Carbon
# DEVICE_TRUST_DAYS=60           # "trust this device" for two-factor sign-in
# GEO_LOOKUP=0                   # 1 looks up the city of each sign-in (sends IPs to a geolocation service)
# ZOLLIFY_MAX_BODY_MB=8          # request size for routes that take no file

# ═══ Can also be set in Server admin ═════════════════════════════════════════

# ── Server
# The address people reach this server at, for links in emails, QR codes and
# payment redirects (defaults to what the proxy reports).
# PUBLIC_ORIGIN=https://pos.example.com
# 1 lets anyone sign up without an invite code.
# REGISTRATION_OPEN=0
# Stored attachments one account may keep (MB), and files per event.
# ZOLLIFY_ACCOUNT_STORAGE_MB=500
# ZOLLIFY_EVENT_FILES_MAX=20
# Webhooks only post to public https addresses. 1 on a LAN-only install allows
# addresses inside your own network (and plain http).
# WEBHOOK_ALLOW_PRIVATE=0

# ── Sign in with Google (optional)
# A "Web application" OAuth client from Google Cloud -> APIs & Services ->
# Credentials, with PUBLIC_ORIGIN/api/auth/google/callback as authorised
# redirect URI. Without both, the login screen shows no Google button. An
# invite code is still needed to join - Google only says who the person is.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Email (optional; read at start-up - restart after changing)
# Without both, nothing is emailed and the app says so; in-app notifications
# work either way.
SMTP_URL=
MAIL_FROM=

# ── Browser notifications for commission customers (optional)
# The contact push services are told about, as mailto: or an https address.
# Without it: MAIL_FROM's address, else PUBLIC_ORIGIN when it is https.
# Apple's push service refuses a made-up one, so set it if customers use iPhones.
# VAPID_SUBJECT=mailto:you@example.com

# ── SumUp
# The affiliate key belongs to the app, not to a merchant: create one once in a
# SumUp account under Settings -> For Developers -> Toolkit -> Affiliate Keys,
# for the app id com.phuongninjin.zollify (SUMUP_APP_ID if your build differs).
# With it, merchants only sign in with their own SumUp login.
# SUMUP_AFFILIATE_KEY=
# SUMUP_APP_ID=
# SumUp Solo over the internet (any till device, a browser too): an OAuth app
# from the same developer account, redirect URL PUBLIC_ORIGIN/p/pos/sumup/authorized.
# SUMUP_CLIENT_ID=
# SUMUP_CLIENT_SECRET=

# ── Nexi SmartPOS (optional)
# Each account adds its own Poynt cloud app under Settings -> Payments. Optionally
# offer one app to accounts without their own: a cloud app from the Poynt
# developer portal with "Cloud Messages" write access and redirect URL
# PUBLIC_ORIGIN/p/pos/smartpos/authorized. POYNT_REGION=eu (Nexi Europe) or us.
# POYNT_APPLICATION_ID=urn:aid:...
# POYNT_PRIVATE_KEY_FILE=/run/secrets/poynt.pem   (or POYNT_PRIVATE_KEY with \n escapes)
# POYNT_REGION=eu
# POYNT_AUTH_PUBLIC_KEY=   (optional: verifies the authorisation code's signature)

# ── e-conomic (Danish bookkeeping)
# This server's app secret token as a registered e-conomic developer. Each
# store connects its own agreement under Settings -> e-conomic.
# ZOLLIFY_ECONOMIC_APP_SECRET=

# ── Feedback and community (optional)
# Send feedback is always kept on this server (Server admin -> Feedback). With
# a Discord channel webhook (channel settings -> Integrations -> Webhooks) each
# one is also posted there - message, screen and app version only.
# DISCORD_INVITE_URL adds a Discord button next to Send feedback.
# FEEDBACK_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_INVITE_URL=https://discord.gg/...
