# One deploy run: git pull, pull the latest image and APKs, restart if changed.
# Triggered by zollify-deploy.path (the "Update server" button); GitHub Actions
# runs the same script over SSH after each push to main.
[Unit]
Description=Zollify unattended deploy
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/zollify
ExecStart=/home/ubuntu/zollify/apps/server/deploy.sh --auto
