# Copy to .env and fill in. .env is gitignored - never commit real values.

# Optional. Left empty, the server mints one on first start and keeps it in
# ZOLLIFY_DATA_DIR/jwt-secret (so it survives restarts and travels with backups).
ZOLLIFY_JWT_SECRET=

# Where SQLite and uploaded data live.
ZOLLIFY_DATA_DIR=./data

# Where published client module bundles are read from.
ZOLLIFY_MODULE_STORE=./modules-store

# Built web app to serve. Leave unset in development - Vite serves it instead.
ZOLLIFY_WEB_DIST=

PORT=8787
HOST=0.0.0.0

# Set to 0 only for local HTTP development. Never in a deployment.
ZOLLIFY_REQUIRE_HTTPS=1

# 1 when running behind a reverse proxy that sets x-forwarded-*.
ZOLLIFY_TRUST_PROXY=1
# The address people reach this server at, for links in emails (defaults to what the proxy reports).
# PUBLIC_ORIGIN=https://pos.example.com

# Nexi SmartPOS (Nets SmartPOS N950) card payments from the till, over Poynt's
# Payment Bridge. Each account adds its own Poynt cloud app under Settings ->
# Payments, so nothing is needed here. Optionally, offer one app to accounts
# without their own: a cloud app from the Poynt developer portal with "Cloud
# Messages" write access and this server's redirect URL
# (PUBLIC_ORIGIN/p/pos/smartpos/authorized). The terminal's callbacks need the
# server on a public https address. POYNT_REGION=eu (default, Nexi Europe) or us.
# POYNT_APPLICATION_ID=urn:aid:...
# POYNT_PRIVATE_KEY_FILE=/run/secrets/poynt.pem   (or POYNT_PRIVATE_KEY with \n escapes)
# POYNT_AUTH_PUBLIC_KEY=   (optional: Poynt's key, to also verify the authorisation code's signature)

# Comma-separated exact origins. Leave empty for same-origin only.
ZOLLIFY_ALLOWED_ORIGINS=

# Caddy running in Docker on this host? Name its network (docker network ls)
# and the Caddyfile can use `reverse_proxy zollify:8787`.
CADDY_NETWORK=


# Outgoing email (optional) - e.g. consignment setup invites to artists.
# Without both, nothing is emailed and the app says so; in-app notifications
# work either way.
SMTP_URL=
MAIL_FROM=

# Webhooks only post to public https addresses. Set to 1 on a LAN-only install
# to allow addresses inside your own network (and plain http).
# WEBHOOK_ALLOW_PRIVATE=0
