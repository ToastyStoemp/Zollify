{
  "name": "@zollify/print-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Print Desk - link files to Zollify products and print them through PhotoCraft",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@zollify/shared": "*",
    "@zollify/ui": "*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^44.9.3",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.0"
  }
}
