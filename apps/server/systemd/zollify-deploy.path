# "Update server" in Settings → Server admin drops apps/server/deploy/requested;
# this unit runs the deploy the moment it appears.
# Install:
#   sudo cp apps/server/systemd/zollify-deploy.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now zollify-deploy.path
[Unit]
Description=Run a Zollify deploy when the app asks for one

[Path]
PathExists=/home/ubuntu/zollify/apps/server/deploy/requested
Unit=zollify-deploy.service

[Install]
WantedBy=multi-user.target
