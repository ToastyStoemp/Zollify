{
  "name": "boothly",
  "version": "0.1.0",
  "private": true,
  "description": "Boothly \u2014 a plugin platform for market and convention booths",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @boothly/web",
    "dev:server": "npm run dev -w @boothly/server",
    "build": "npm run build --workspaces --if-present",
    "build:modules": "npm run build -w @boothly/pos -w @boothly/customs -w @boothly/price-cards -w @boothly/sourcing -w @boothly/migration -w @boothly/shopify-sync",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:deps": "npm audit --audit-level=moderate",
    "publish:modules": "node scripts/publish-modules.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
}
