{
  "name": "zollify",
  "version": "0.1.0",
  "private": true,
  "description": "Zollify - a plugin platform for market and convention booths",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zollify/web",
    "dev:server": "npm run dev -w @zollify/server",
    "build": "npm run build --workspaces --if-present",
    "build:modules": "npm run build -w @zollify/pos -w @zollify/customs -w @zollify/price-cards -w @zollify/sourcing -w @zollify/migration -w @zollify/shopify-sync -w @zollify/public-events -w @zollify/tax -w @zollify/costs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:deps": "npm audit --audit-level=moderate",
    "publish:modules": "node scripts/publish-modules.mjs",
    "build:web": "npm run build -w @zollify/web",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:apk": "node scripts/bump-android-version.mjs && npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:pack": "node scripts/pack-apk.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^5.0.1",
    "@capacitor/cli": "^8.3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
