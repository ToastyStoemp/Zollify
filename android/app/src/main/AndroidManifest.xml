<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility (Android 11+): the carbon flavor talks to the myPOS
         payment core, the full flavor to the myPOS Glass softPOS app; flavors
         that don't ship the respective SDK simply never query these. -->
    <queries>
        <package android:name="com.mypos" />
        <package android:name="com.mypos.top" />
    </queries>

    <application
        android:name=".ZollifyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Product photos are taken straight from the catalogue on a phone. Optional,
         so devices without a camera still install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Self-update: install a newer APK downloaded from the server (UpdaterPlugin.kt).
         Still needs the user's one-time "allow installs from this app" consent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Bluetooth for the myPOS GO2 / Carbon card terminals (see MyPosPlugin.kt) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BLE device discovery requires location on API <= 30, and the myPOS slave
         SDK's own permission gate additionally insists on ACCESS_COARSE_LOCATION on
         EVERY Android version before it shows the terminal picker — so declare
         location unrestricted. Without it the picker silently never appears. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- androidx.core auto-declares this self-signature permission (its
         RECEIVER_NOT_EXPORTED backport for pre-API-33 registerReceiver calls) in
         every app that depends on it. Every registerReceiver call in this app
         explicitly uses RECEIVER_EXPORTED, not RECEIVER_NOT_EXPORTED, so it's
         unused here — strip it from the merged manifest. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
</manifest>
